# Max Bot Configuration
MAX_BOT_TOKEN=your_max_bot_token_here
# ID администратора бота
ADMIN_USER_ID=max_user_id
# ID чата администратора (для получения уведомлений)
ADMIN_CHAT_ID=admin_chat_id
# ID отслеживаемого чата
CHAT_ID=tracked_chat_id
# Ключ API OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Joomla Integration
# Список ID статей для обновления (через запятую)
JOOMLA_ARTICLE_IDS=1025,1027,1028,1029
# URL сайта Joomla
JOOMLA_SITE_URL=https://plk32.ru
# URL админки Joomla
JOOMLA_ADMIN_URL=https://plk32.ru/administrator
# Логин для аутентификации в Joomla
JOOMLA_USERNAME=admin
# Пароль для аутентификации в Joomla
JOOMLA_PASSWORD=your_joomla_password
# Токен для доступа к PHP API (если используется update_article.php)
JOOMLA_API_TOKEN=your_joomla_api_token